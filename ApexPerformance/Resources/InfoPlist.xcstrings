{
  "sourceLanguage" : "hr",
  "strings" : {
    "NSHealthShareUsageDescription" : {
      "comment" : "Asked when the client connects Apple Health",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apex liest deine Herzfrequenz während der Trainings mit deinem Coach sowie Schlaf, Schritte, verbrannte Kalorien und Ruhepuls für deinen Tagesüberblick. An deinen Coach werden nur die niedrigste, höchste und durchschnittliche Herzfrequenz während der Trainings gesendet; den Tagesüberblick siehst nur du."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apex reads your heart rate during trainings with your coach, and your sleep, steps, burned calories and resting heart rate for your daily overview. Only the lowest, highest and average heart rate during trainings are sent to your coach; the daily overview is shown only to you."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apex čita tvoj puls za vrijeme treninga s trenerom te san, korake, potrošene kalorije i puls u mirovanju za tvoj dnevni pregled. Treneru se šalju samo najniži, najviši i prosječni puls za vrijeme treninga; dnevni pregled vidiš samo ti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apex legge la tua frequenza cardiaca durante gli allenamenti con il coach e sonno, passi, calorie bruciate e frequenza a riposo per la tua panoramica giornaliera. Al coach vengono inviate solo la frequenza minima, massima e media durante gli allenamenti; la panoramica giornaliera è visibile solo a te."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "comment" : "Required with HealthKit, the app doesn't write",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apex schreibt keine Daten in Apple Health, sondern liest nur deine Herzfrequenz während der Trainings mit deinem Coach."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apex doesn't write to Apple Health, it only reads your heart rate during trainings with your coach."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apex ne zapisuje podatke u Apple Health, samo čita tvoj puls za vrijeme treninga s trenerom."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apex non scrive dati in Apple Salute, legge solo la tua frequenza cardiaca durante gli allenamenti con il coach."
          }
        }
      }
    }
  },
  "version" : "1.0"
}