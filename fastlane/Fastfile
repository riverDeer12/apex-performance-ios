require "base64"
require "fileutils"
require "tmpdir"

default_platform(:ios)

platform :ios do
  desc "Build the app and upload it to TestFlight"
  desc "Signing is cloud managed through the App Store Connect API key,"
  desc "so no certificate or provisioning profile is kept in the repo."
  desc "APP_VARIANT=test (default) builds the Test Apex app with its own"
  desc "bundle id, name and icon; APP_VARIANT=store builds the App Store app."
  lane :beta do
    store_id = CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)
    test_app = ENV.fetch("APP_VARIANT", "test").strip.downcase != "store"
    app_id = test_app ? "#{store_id}.test" : store_id

    key_id = ENV.fetch("ASC_KEY_ID")
    issuer_id = ENV.fetch("ASC_ISSUER_ID")
    key_content = ENV.fetch("ASC_KEY_CONTENT")

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_content: key_content,
      is_key_content_base64: true
    )

    # xcodebuild needs the key as a file for automatic signing.
    key_path = File.join(Dir.tmpdir, "AuthKey_#{key_id}.p8")
    File.write(key_path, Base64.decode64(key_content))

    # Next build number after the latest one on this app's TestFlight.
    latest = latest_testflight_build_number(api_key: api_key, app_identifier: app_id, initial_build_number: 0)
    build_number = latest.to_i + 1
    versions = [lane_context[SharedValues::LATEST_TESTFLIGHT_VERSION]]

    if test_app
      use_test_firebase_config
      # The test app follows the App Store app's versions.
      latest_testflight_build_number(api_key: api_key, app_identifier: store_id, initial_build_number: 0)
      versions << lane_context[SharedValues::LATEST_TESTFLIGHT_VERSION]
    end

    version = app_version(api_key, store_id, versions.compact)
    UI.message("Building #{app_id} version #{version} (#{build_number})")

    # Apple Health: the cloud managed profiles include HealthKit only when
    # the App ID has the capability.
    enable_capability(app_id, "HEALTHKIT")
    # Live Activity of a training in progress (widget extension).
    ensure_bundle_id("#{app_id}.TrainingActivity", "Apex Training Activity#{test_app ? ' Test' : ''}")

    auth = "-allowProvisioningUpdates " \
           "-authenticationKeyPath #{key_path} " \
           "-authenticationKeyID #{key_id} " \
           "-authenticationKeyIssuerID #{issuer_id}"

    build_app(
      project: "ApexPerformance.xcodeproj",
      scheme: "ApexPerformance",
      configuration: "Release",
      export_method: "app-store",
      # The unsigned archive has no team, the export needs it.
      export_team_id: CredentialsManager::AppfileConfig.try_fetch_value(:team_id),
      output_directory: "build",
      # gym passes xcargs to the export too, so the key isn't given twice.
      # The archive is signed ad hoc, without a certificate: signing it with
      # a development certificate made Xcode create a new one on every
      # runner until the account hit the limit, and an unsigned archive
      # loses the entitlements (no aps-environment, so no push
      # notifications). The export signs the app with the cloud managed
      # distribution certificate and keeps the entitlements.
      xcargs: "#{auth} APP_VARIANT=#{test_app ? 'Test' : 'Store'} " \
              "MARKETING_VERSION=#{version} CURRENT_PROJECT_VERSION=#{build_number} " \
              "CODE_SIGN_STYLE=Manual CODE_SIGN_IDENTITY=- AD_HOC_CODE_SIGNING_ALLOWED=YES " \
              "PROVISIONING_PROFILE_SPECIFIER= PROVISIONING_PROFILE="
    )

    check_push_entitlement(lane_context[SharedValues::IPA_OUTPUT_PATH])

    upload_to_testflight(
      api_key: api_key,
      app_identifier: app_id,
      # The build appears in TestFlight once Apple has processed it.
      skip_waiting_for_build_processing: true
    )

    upload_crashlytics_symbols
  ensure
    File.delete(key_path) if key_path && File.exist?(key_path)
  end

  desc "Prepare the App Store version of the newest App Store build:"
  desc "What's New from fastlane/whats_new/<language>.txt, the screenshots"
  desc "in SCREENSHOTS_DIR (iPhone 6.9\" and iPad 13\" PNGs, in order) and"
  desc "selects the build. Nothing is submitted for review."
  lane :store_listing do
    store_id, api_key, version, build_number = newest_store_build

    # Only the languages the App Store listing already has are filled;
    # a new language would need its own description and keywords.
    app = Spaceship::ConnectAPI::App.find(store_id)
    UI.user_error!("No app #{store_id} on App Store Connect") unless app
    platform = Spaceship::ConnectAPI::Platform::IOS
    listing = app.get_edit_app_store_version(platform: platform) ||
              app.get_live_app_store_version(platform: platform)
    localizations = listing.get_app_store_version_localizations
    locales = localizations.map(&:locale)
    UI.message("Languages: #{locales.join(', ')}, primary #{app.primary_locale}")

    # Screenshots go to the primary language and to every language that
    # has its own; the others show the primary language's.
    screenshot_locales = localizations.select do |localization|
      localization.locale == app.primary_locale || localization.get_app_screenshot_sets.any?
    end.map(&:locale)

    Dir.mktmpdir do |dir|
      metadata_path = File.join(dir, "metadata")
      screenshots_path = File.join(dir, "screenshots")
      source = File.expand_path(ENV.fetch("SCREENSHOTS_DIR"))
      pngs = Dir.glob(File.join(source, "**", "*.png")).sort
      UI.user_error!("No screenshots in #{source}") if pngs.empty?

      locales.each do |locale|
        language = locale.split("-").first
        notes = File.join("whats_new", "#{language}.txt")
        notes = File.join("whats_new", "en.txt") unless File.exist?(notes)
        FileUtils.mkdir_p(File.join(metadata_path, locale))
        FileUtils.cp(notes, File.join(metadata_path, locale, "release_notes.txt"))
      end

      screenshot_locales.each do |locale|
        target = File.join(screenshots_path, locale)
        FileUtils.mkdir_p(target)
        # deliver keeps the order of the file names; the device folder
        # goes into the name so both devices stay apart.
        pngs.each do |png|
          device = File.basename(File.dirname(png)).gsub(/[^A-Za-z0-9]/, "")
          FileUtils.cp(png, File.join(target, "#{device}-#{File.basename(png)}"))
        end
      end

      deliver(
        api_key: api_key,
        app_identifier: store_id,
        app_version: version,
        build_number: build_number,
        skip_binary_upload: true,
        metadata_path: metadata_path,
        screenshots_path: screenshots_path,
        overwrite_screenshots: true,
        submit_for_review: false,
        run_precheck_before_submit: false,
        force: true
      )
    end

    store_build
  end

  desc "Select the newest App Store build for the App Store version that is"
  desc "being prepared. deliver only selects a build when it submits for review."
  lane :store_build do
    store_id, _api_key, version, build_number = newest_store_build
    build = wait_until_processed(store_id, version, build_number)

    platform = Spaceship::ConnectAPI::Platform::IOS
    app = Spaceship::ConnectAPI::App.find(store_id)
    edit = app.get_edit_app_store_version(platform: platform)
    UI.user_error!("No App Store version is being prepared") unless edit

    edit.select_build(build_id: build.id)
    UI.success("Version #{edit.version_string} now has build #{version} (#{build_number})")
  end

  # App Store app id, API key and the version and number of its newest
  # build, also one Apple is still processing (just uploaded).
  def newest_store_build
    store_id = CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_CONTENT"),
      is_key_content_base64: true
    )

    app = Spaceship::ConnectAPI::App.find(store_id)
    UI.user_error!("No app #{store_id} on App Store Connect") unless app
    build = Spaceship::ConnectAPI::Build.all(
      app_id: app.id, platform: Spaceship::ConnectAPI::Platform::IOS, sort: "-uploadedDate", limit: 1
    ).first
    UI.user_error!("No builds of #{store_id} on App Store Connect") unless build

    version = build.app_version
    build_number = build.version.to_s
    UI.message("App Store version #{version} with build #{build_number}")
    [store_id, api_key, version, build_number]
  end

  # Apple processes an uploaded build before it can be selected, usually
  # in 10 to 30 minutes. Waits for it up to an hour.
  def wait_until_processed(store_id, version, build_number)
    app = Spaceship::ConnectAPI::App.find(store_id)
    deadline = Time.now + 60 * 60
    loop do
      build = Spaceship::ConnectAPI::Build.all(
        app_id: app.id, version: version, build_number: build_number,
        platform: Spaceship::ConnectAPI::Platform::IOS
      ).first
      state = build&.processing_state
      return build if state == Spaceship::ConnectAPI::Build::ProcessingState::VALID
      if [Spaceship::ConnectAPI::Build::ProcessingState::FAILED,
          Spaceship::ConnectAPI::Build::ProcessingState::INVALID].include?(state)
        UI.user_error!("Build #{version} (#{build_number}) is #{state}")
      end
      UI.user_error!("Build #{version} (#{build_number}) still not processed after an hour") if Time.now > deadline

      UI.message("Build #{version} (#{build_number}) is #{state || 'not on App Store Connect yet'}, waiting...")
      sleep(60)
    end
  end

  # Turns on a capability (e.g. HEALTHKIT) of the bundle id on the
  # Developer portal through the App Store Connect API, once.
  def enable_capability(app_id, type)
    bundle_id = Spaceship::ConnectAPI::BundleId.find(app_id)
    UI.user_error!("No bundle id #{app_id} on the Developer portal") unless bundle_id
    return if bundle_id.get_capabilities.any? { |capability| capability.capability_type == type }

    bundle_id.create_capability(type)
    UI.message("Turned on #{type} for #{app_id}")
  end

  # Registers the bundle id of an app extension on the Developer portal
  # when it isn't there yet, so the export can sign it.
  def ensure_bundle_id(identifier, name)
    return if Spaceship::ConnectAPI::BundleId.find(identifier)

    Spaceship::ConnectAPI::BundleId.create(
      name: name,
      platform: Spaceship::ConnectAPI::Platform::IOS,
      identifier: identifier
    )
    UI.message("Registered #{identifier}")
  end

  # Crash reports name the code lines only with the build's dSYMs. A failed
  # upload doesn't stop the release, it shows as a warning on the run.
  def upload_crashlytics_symbols
    dsym = lane_context[SharedValues::DSYM_OUTPUT_PATH]
    tool = Dir.glob(File.expand_path(
      "~/Library/Developer/Xcode/DerivedData/*/SourcePackages/checkouts/firebase-ios-sdk/Crashlytics/upload-symbols"
    )).first
    unless dsym && tool
      puts "::warning title=Crashlytics::No dSYMs or upload-symbols tool, crash reports won't show code lines"
      return
    end

    upload_symbols_to_crashlytics(
      dsym_path: dsym,
      # Actions run from the repository root, so the path is absolute.
      gsp_path: File.expand_path("../ApexPerformance/GoogleService-Info.plist", __dir__),
      binary_path: tool
    )
  rescue StandardError => e
    puts "::warning title=Crashlytics::dSYM upload failed: #{e.message}"
  end

  # Without the aps-environment entitlement iOS gives the app no push
  # token, so no push notification would reach it. Stops the upload then.
  def check_push_entitlement(ipa_path)
    Dir.mktmpdir do |dir|
      sh("unzip", "-q", ipa_path, "-d", dir, log: false)
      app = Dir.glob(File.join(dir, "Payload", "*.app")).first
      entitlements = sh("codesign", "-d", "--entitlements", ":-", app, log: false)
      # Shown as an annotation of the GitHub run.
      level = entitlements.include?("aps-environment") ? "notice" : "error"
      puts "::#{level} title=Entitlements::#{entitlements.gsub("\n", "%0A")}"
      UI.user_error!("The exported app has no aps-environment entitlement") if level == "error"
    end
  end

  # Firebase needs the config of the Firebase app registered for the test
  # bundle id, otherwise push notifications don't reach the test app.
  # Only the CI checkout is changed.
  def use_test_firebase_config
    test_config = "../ApexPerformance/Config/GoogleService-Info-Test.plist"
    if File.exist?(test_config)
      FileUtils.cp(test_config, "../ApexPerformance/GoogleService-Info.plist")
    else
      UI.important("No GoogleService-Info-Test.plist, push notifications won't work in the test app")
    end
  end

  # Version to upload: APP_VERSION when given (workflow input), otherwise
  # the highest of the project's and TestFlight's versions. A version that
  # is already live on the App Store can't get new builds, so then the
  # last number is raised (1.5 -> 1.6).
  def app_version(api_key, store_id, testflight_versions)
    given = ENV["APP_VERSION"].to_s.strip
    return given unless given.empty?

    # Lanes run inside the fastlane folder, the project is one level up.
    versions = File.read("../ApexPerformance.xcodeproj/project.pbxproj")
                   .scan(/MARKETING_VERSION = ([\d.]+);/).flatten
    versions.concat(testflight_versions)
    version = versions.max_by { |v| Gem::Version.new(v) }

    live_version = begin
      app_store_build_number(api_key: api_key, app_identifier: store_id, live: true)
      lane_context[SharedValues::LATEST_VERSION]
    rescue StandardError
      nil
    end

    if live_version && Gem::Version.new(live_version) >= Gem::Version.new(version)
      parts = live_version.split(".").map(&:to_i)
      parts[-1] += 1
      version = parts.join(".")
    end

    version
  end
end
